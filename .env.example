# Copy this file to .env and replace every change-me value before starting Docker Compose.
# These are placeholders only; do not commit real credentials.

# MySQL / backend database connection
RESOLVEDESK_MYSQL_DATABASE=resolvedesk
RESOLVEDESK_MYSQL_PORT=3306
RESOLVEDESK_MYSQL_ROOT_PASSWORD=change-me-root-password
RESOLVEDESK_DB_USERNAME=resolvedesk
RESOLVEDESK_DB_PASSWORD=change-me-application-password
# Used when running the backend directly instead of through Docker Compose.
RESOLVEDESK_DB_URL=jdbc:mysql://localhost:3306/resolvedesk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Initial administrator bootstrap configuration. Required for a first admin account.
RESOLVEDESK_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
RESOLVEDESK_BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-password
RESOLVEDESK_BOOTSTRAP_ADMIN_FIRST_NAME=Admin
RESOLVEDESK_BOOTSTRAP_ADMIN_LAST_NAME=User

# Local ports
RESOLVEDESK_BACKEND_PORT=8080
RESOLVEDESK_FRONTEND_PORT=5173
# Vite development proxy target (not bundled into the frontend).
RESOLVEDESK_BACKEND_ORIGIN=http://localhost:8080

# Leave empty for Docker Compose so Nginx proxies /api/v1 to the backend.
VITE_API_BASE_URL=
